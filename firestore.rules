rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Users Profile Collection
    match /users/{userId} {
      allow read, write: if true;

      // Timeline entries transaction log
      match /timeline/{itemId} {
        allow read, write: if true;
      }
    }

    // 2. News Feed Collection
    match /news/{newsId} {
      allow read, write: if true;
    }

    // 3. Events Schedule Collection
    match /events/{eventId} {
      allow read, write: if true;
    }

    // 4. Registrations Collection
    match /registrations/{registrationId} {
      allow read, write: if true;
    }

    // 5. Exemption Certificate ledger
    match /certificates/{certificateId} {
      allow read, write: if true;
    }

    // 6. Quizzes Collection
    match /quizzes/{quizId} {
      allow read, write: if true;
    }
  }
}
