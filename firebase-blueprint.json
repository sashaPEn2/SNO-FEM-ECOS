{
  "entities": {
    "StudentProfile": {
      "title": "StudentProfile",
      "description": "Information about a registered student user",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "description": "Unique student identifier" },
        "name": { "type": "string", "description": "Full name" },
        "course": { "type": "integer", "description": "Academic course year" },
        "group": { "type": "string", "description": "Student group" },
        "points": { "type": "integer", "description": "Academic activity points balance" },
        "exemptionCount": { "type": "integer", "description": "Number of exemption certificates used" },
        "role": { "type": "string", "enum": ["student", "sno_activist"], "description": "Role level" },
        "email": { "type": "string", "description": "Institution email address" },
        "isBudget": { "type": "boolean", "description": "Whether the student is on budget funding" },
        "phone": { "type": "string", "description": "Phone number" }
      },
      "required": ["studentId", "name", "course", "group", "points", "exemptionCount"]
    },
    "NewsItem": {
      "title": "NewsItem",
      "description": "An article published on SNO news channel",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "content": { "type": "string" },
        "date": { "type": "string" },
        "category": { "type": "string", "enum": ["conference", "science", "grant", "announcement"] },
        "imageUrl": { "type": "string" },
        "views": { "type": "integer" },
        "likes": { "type": "integer" }
      },
      "required": ["id", "title", "content", "date", "category", "views", "likes"]
    },
    "ScienceEvent": {
      "title": "ScienceEvent",
      "description": "Upcoming science event or conference",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "location": { "type": "string" },
        "pointsForSpeaker": { "type": "integer" },
        "pointsForListener": { "type": "integer" },
        "description": { "type": "string" },
        "requirements": { "type": "string" },
        "registeredCount": { "type": "integer" }
      },
      "required": ["id", "title", "date", "time", "location", "pointsForSpeaker", "pointsForListener", "description", "registeredCount"]
    },
    "EventRegistration": {
      "title": "EventRegistration",
      "description": "A student's registration booking for a conference event",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "eventId": { "type": "string" },
        "eventTitle": { "type": "string" },
        "eventDate": { "type": "string" },
        "studentName": { "type": "string" },
        "studentGroup": { "type": "string" },
        "studentId": { "type": "string" },
        "role": { "type": "string", "enum": ["speaker", "listener"] },
        "paperTitle": { "type": "string" },
        "registrationDate": { "type": "string" },
        "qrCodeValue": { "type": "string" }
      },
      "required": ["id", "eventId", "eventTitle", "eventDate", "studentName", "studentGroup", "studentId", "role", "registrationDate", "qrCodeValue"]
    },
    "ExemptionCertificate": {
      "title": "ExemptionCertificate",
      "description": "Official exemption slip generated inside the system ledger",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentGroup": { "type": "string" },
        "dateRequested": { "type": "string" },
        "targetExemptionDate": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "archived"] },
        "reason": { "type": "string" },
        "verificationCode": { "type": "string" },
        "pointsDeducted": { "type": "integer" },
        "endDate": { "type": "string" },
        "course": { "type": "integer" },
        "isBudget": { "type": "boolean" },
        "phone": { "type": "string" },
        "supportingDocs": { "type": "string" }
      },
      "required": ["id", "studentId", "studentName", "studentGroup", "dateRequested", "targetExemptionDate", "status", "reason", "verificationCode", "pointsDeducted"]
    },
    "Quiz": {
      "title": "Quiz",
      "description": "An interactive scientific quiz with points rewards",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "pointsReward": { "type": "integer" }
      },
      "required": ["id", "title", "description", "category", "pointsReward"]
    },
    "TimelineItem": {
      "title": "TimelineItem",
      "description": "An entry in points transaction and academic milestone history",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["quiz", "event_registration", "manual_activity", "exemption_purchase", "academic_award"] },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "pointsChange": { "type": "integer" },
        "details": { "type": "string" },
        "isReward": { "type": "boolean" }
      },
      "required": ["id", "type", "title", "date", "pointsChange", "details"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "StudentProfile",
      "description": "Stores standard and SNO activist profiles keyed by auth ID"
    },
    "news/{newsId}": {
      "schema": "NewsItem",
      "description": "Science blog articles and feeds"
    },
    "events/{eventId}": {
      "schema": "ScienceEvent",
      "description": "Scientific conferences, lectures, and event schedules"
    },
    "registrations/{registrationId}": {
      "schema": "EventRegistration",
      "description": "Interactive registration bookings for academic seminars and events"
    },
    "certificates/{certificateId}": {
      "schema": "ExemptionCertificate",
      "description": "Verifiable generated class exemption slips with public QR resolution capability"
    },
    "quizzes/{quizId}": {
      "schema": "Quiz",
      "description": "Scientific and economic questionnaires created dynamically"
    },
    "users/{userId}/timeline/{itemId}": {
      "schema": "TimelineItem",
      "description": "Milestone event logs or transaction balances"
    }
  }
}
